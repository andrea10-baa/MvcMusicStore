@model MvcMusicStore.Models.Order

@{
    ViewBag.Title = "Dirección y pago";
}

<h2 class="section-title">Dirección y pago</h2>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>Datos de envío</legend>
        @Html.EditorForModel()
    </fieldset>

    <fieldset>
        <legend>Pago</legend>
        <p class="text-muted">
            Estamos de promoción: toda la música es gratis con el código <strong>FREE</strong>.
        </p>
        <div class="editor-label">
            @Html.Label("PromoCode", "Código promocional")
        </div>
        <div class="editor-field">
            @Html.TextBox("PromoCode", null, new { @class = "form-control" })
        </div>
    </fieldset>

    <input type="submit" value="Enviar pedido" class="btn btn-primary btn-lg" />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
}