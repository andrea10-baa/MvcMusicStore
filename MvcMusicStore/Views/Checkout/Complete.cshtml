@model int

@{
    ViewBag.Title = "Pedido completado";
}

<div class="auth-box text-center" style="max-width:560px;">
    <h2 class="mt-3">¡Gracias por tu pedido!</h2>
    <p class="text-muted mb-1">Tu número de pedido es:</p>
    <p class="album-price" style="font-size:2rem;">#@Model</p>
    <p class="text-muted">Guardá este número por si necesitás consultar tu compra.</p>

    <div class="mt-4">
        @Html.ActionLink("Ver detalle de mi compra", "Details", "Pedidos", new { id = Model }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Seguir comprando", "Index", "Store", null, new { @class = "btn btn-outline-dark" })
        @Html.ActionLink("Ir al inicio", "Index", "Home", null, new { @class = "btn btn-outline-dark" })
    </div>
</div>